# Copy this file to .env and fill in what you have. Everything is optional —
# the app runs on free/no-key data (yfinance, SEC, FRED) out of the box.

# Dash server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=true

# How often the Overview, Company, and Commodities pages auto-refresh, in
# milliseconds. Lower = more real-time, but more requests to yfinance —
# pushing much below 15000 risks rate-limiting. Default: 30000 (30s).
DASHBOARD_REFRESH_MS=30000

# OpenBB default provider for endpoints that support multiple providers.
OPENBB_DEFAULT_PROVIDER=yfinance

# Optional premium data providers (unlocks peer lookup, ratios, deeper
# screener filters, and richer estimates). Get a free-tier key from each
# provider's site and set it below — OpenBB auto-detects credentials from env
# vars named OPENBB_<PROVIDER>_API_KEY:
# OPENBB_FMP_API_KEY=
# OPENBB_INTRINIO_API_KEY=
# OPENBB_BENZINGA_API_KEY=
# OPENBB_TIINGO_TOKEN=
